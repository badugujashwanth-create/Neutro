{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neutro Desktop",
  "version": "0.1.0",
  "identifier": "com.neutro.desktop",
  "build": {
    "beforeDevCommand": "cd ../web && npm run dev -- --host 127.0.0.1 --port 5173 --strictPort",
    "beforeBuildCommand": "cd ../web && npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Neutro Desktop",
        "width": 1400,
        "height": 900,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
